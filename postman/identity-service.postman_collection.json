{
  "info": {
    "name": "Identity Service API",
    "_postman_id": "12345-identity-service",
    "description": "API-first Identity Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create User V1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"v1.user@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users"]
        }
      }
    },
    {
      "name": "Get User V1",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "{{userId}}"]
        }
      }
    },
    {
      "name": "Delete User V1",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/v1/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "{{userId}}"]
        }
      }
    },
    {
      "name": "Create User V2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"v2.user@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/users",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "users"]
        }
      }
    },
    {
      "name": "Get User V2",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v2/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "users", "{{userId}}"]
        }
      }
    },
    {
      "name": "Update User V2",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Updated\",\n  \"status\": \"SUSPENDED\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "users", "{{userId}}"]
        }
      }
    }
  ]
}
